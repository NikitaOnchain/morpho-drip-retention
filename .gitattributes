# Preserve every checksum-bound file regardless of core.autocrlf.
* -text
# Preserve byte identities of accepted evidence and checksum-bound code.
*.csv -text
*.json -text
*.md -text
*.sql -text
*.py -text
*.ps1 -text
*.png binary

# Keep release control files stable across checkouts.
/LICENSE text eol=lf
/release/SHA256SUMS.txt text eol=lf
